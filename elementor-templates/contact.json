            {
              "id": "9851445",
              "elType": "widget",
              "settings": {
                "title": "Seen something unusual?",
                "header_size": "h2",
                "align": "left",
                "title_color": "#16241D",
                "typography_typography": "custom",
                "typography_font_family": "Sora",
