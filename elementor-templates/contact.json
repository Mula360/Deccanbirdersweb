            {
              "id": "a632029",
              "elType": "widget",
              "settings": {
                "editor": "<p>Your entry goes to <a href=\"mailto:photos@deccanbirders.org\">photos@deccanbirders.org</a> for review. Once a committee member approves it, the photograph appears in the gallery credited to you by name.</p><ul><li>Tell us the name you would like the credit to read.</li><li>One bird per frame, no baiting, no nest photography during breeding.</li><li>Approvals usually take a week; you'll hear back either way.</li></ul>",
                "typography_typography": "custom",
