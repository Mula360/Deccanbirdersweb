            {
              "id": "f882c01",
              "elType": "widget",
              "settings": {
                "editor": "<p>Tell us what you saw, where and when. You can also put your hand up for the winter waterfowl census or a school outreach session.</p>",
                "typography_typography": "custom",
                "typography_font_family": "Source Sans 3",
                "typography_font_size": {
                  "unit": "px",
                  "size": 15,
                  "sizes": []
                }
              },
              "elements": [],
              "widgetType": "text-editor"
            },
            {
              "id": "afdbbaf",
              "elType": "widget",
              "settings": {
                "html": "<form id=\"db-volunteer-form\" class=\"submission-form\" novalidate>\n  <div class=\"form-field\">\n    <label for=\"vf-details\">Species and location</label>\n    <textarea id=\"vf-details\" name=\"details\" rows=\"3\"></textarea>\n  </div>\n  <div class=\"form-field\">\n    <label for=\"vf-help\">I'd like to help with</label>\n    <select id=\"vf-help\" name=\"help_with\">\n      <option>Reporting a sighting only</option>\n      <option>Annual waterfowl census</option>\n      <option>Field trip coordination</option>\n      <option>School and college outreach</option>\n      <option>PITTA newsletter</option>\n    </select>\n  </div>\n  <button type=\"submit\" class=\"btn btn-secondary\">Submit</button>\n</form>"
              },
              "elements": [],
              "widgetType": "html"
            }
