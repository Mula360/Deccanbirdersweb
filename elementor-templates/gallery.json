              "elType": "widget",
              "settings": {
                "title": "Submit a photograph",
                "header_size": "h2",
                "align": "left",
                "title_color": "#16241D",
                "typography_typography": "custom",
                "typography_font_family": "Sora",
                "typography_font_size": {
                  "unit": "px",
                  "size": 32,
